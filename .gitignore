ui/scripts/env-config.js

# Temp
*.zip
*.bak-*
/tmp/
ev.json
out.json

# Lambda invoke scratch, written into the repo ROOT by five diagnostic scripts
# (calibrate_homogeneity, compare_homogeneity_statistics, measure_frame_spread,
# verify_speaker_chain, and the ad-hoc invokes people run by hand). `ev.json` and
# `out.json` above are the same hazard, already named one file at a time.
#
# These are not harmless temp files. The `*_out.json` half holds whatever the lambda
# returned: S3 keys naming a real user's folder and recording, and in the case of
# `GET /api/org/voiceprints`, people's display names. This repository already carries a
# standing rule against `git add -A` on develop, and the reason it needs one is files
# exactly like these sitting untracked in the root.
_*.json

# Regenerated by every `uv run --with ...` invocation of the speaker harness. Not a
# dependency decision: no workflow or script reads it, and committing it makes an ad-hoc
# tool run look like one.
uv.lock
